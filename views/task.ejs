<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Tasks</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container large">
        <h1 class="title">My Tasks</h1>

        <!-- Notification banner (shown by WebSocket messages) -->
        <div id="notification-banner" class="notification hidden"></div>

        <form class="form" action="/task" method="POST">
            <input class="input" type="text" name="title" placeholder="Task title" required />
            <input class="input" type="text" name="description" placeholder="Description" required />
            <input class="input" type="datetime-local" name="due_date" required />
            <button class="btn" type="submit">Add Task</button>
        </form>

        <% if (tasks.length === 0) { %>
            <p class="error">You have no tasks yet.</p>
        <% } else { %>
            <ul class="task-list">
                <% tasks.forEach(task => { %>
                    <li class="task-item task-item--<%= task.status.replace(' ', '-') %>" id="task-<%= task._id %>">
                        <div class="task-info">
                            <span class="task-title"><%= task.title %></span>
                            <span class="task-desc"><%= task.description %></span>
                            <span class="task-meta">
                                Due: <%= task.due_date ? new Date(task.due_date).toLocaleString() : 'N/A' %>
                            </span>
                            <span class="task-badge task-badge--<%= task.status.replace(' ', '-') %>">
                                <%= task.status.charAt(0).toUpperCase() + task.status.slice(1) %>
                            </span>
                        </div>

                        <div class="task-actions">
                            <% if (task.status !== 'completed' && task.status !== 'overdue') { %>
                                <form class="inline-form" action="/task/<%= task._id %>/update" method="POST">
                                    <select name="status">
                                        <option value="pending" <%= task.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                        <option value="in progress" <%= task.status === 'in progress' ? 'selected' : '' %>>In Progress</option>
                                        <option value="completed">Completed</option>
                                    </select>
                                    <button class="btn" type="submit">Update</button>
                                </form>
                            <% } else if (task.status === 'overdue') { %>
                                <!-- Allow marking overdue tasks as completed -->
                                <form class="inline-form" action="/task/<%= task._id %>/update" method="POST">
                                    <input type="hidden" name="status" value="completed" />
                                    <button class="btn btn-success" type="submit">Mark Complete</button>
                                </form>
                            <% } %>

                            <form class="inline-form" action="/task/<%= task._id %>/delete" method="POST">
                                <button class="btn btn-danger" type="submit">Delete</button>
                            </form>
                        </div>
                    </li>
                <% }) %>
            </ul>
        <% } %>

        <form action="/logout" method="POST">
            <button type="submit" class="btn btn-secondary">Logout</button>
        </form>
    </div>

    <script>
      (function () {
        const token = "<%= wsToken %>";
        if (!token) return;

        const banner = document.getElementById("notification-banner");

        function showNotification(message, type) {
          banner.textContent = message;
          banner.className = "notification notification--" + type;
          // Auto-hide after 6 seconds
          clearTimeout(banner._hideTimer);
          banner._hideTimer = setTimeout(() => {
            banner.className = "notification hidden";
          }, 6000);
        }

        function connect() {
          const protocol = location.protocol === "https:" ? "wss" : "ws";
          const ws = new WebSocket(protocol + "://" + location.host + "/ws?token=" + encodeURIComponent(token));

          ws.addEventListener("message", function (event) {
            let data;
            try { data = JSON.parse(event.data); } catch (e) { return; }

            if (data.type === "task_overdue") {
              showNotification("⚠️ " + data.message, "overdue");
              // Update the task badge in the DOM without a full reload
              const item = document.getElementById("task-" + data.taskId);
              if (item) {
                item.className = "task-item task-item--overdue";
                const badge = item.querySelector(".task-badge");
                if (badge) { badge.textContent = "Overdue"; badge.className = "task-badge task-badge--overdue"; }
              }
            }

            if (data.type === "task_completed") {
              showNotification("✅ " + data.message, "completed");
            }
          });

          ws.addEventListener("close", function (e) {
            // Reconnect after 5 s unless it was an auth failure
            if (e.code !== 4001) {
              setTimeout(connect, 5000);
            }
          });

          ws.addEventListener("error", function () {
            ws.close();
          });
        }

        connect();
      })();
    </script>
</body>
</html>
